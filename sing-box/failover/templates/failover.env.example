# Формат systemd EnvironmentFile. Замените все плейсхолдеры перед запуском.
# Хранить реальный файл вне Git, с правами 0600.
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_NOTIFY_CHAT_ID=<TELEGRAM_CHAT_ID>
OPENAI_TRANSPORT_URL=https://chatgpt.com/backend-api/codex
OPENAI_CHECK_COMMAND="/home/<USER>/.local/bin/hermes --oneshot 'Reply with OK only' --provider openai-codex -m <MODEL> --toolsets safe --ignore-rules --ignore-user-config"
HTTP_CHECK_USER_AGENT=singbox-failover/1.0
