[Unit]
Description=sing-box failover controller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Замените <USER>: full probe должен использовать нужное хранилище Hermes.
Environment=HOME=/home/<USER>
Environment=HERMES_HOME=/home/<USER>/.hermes
EnvironmentFile=/opt/singbox-failover/failover.env
ExecStart=/usr/bin/python3 /opt/singbox-failover/scripts/singbox_failover.py --inventory /opt/singbox-failover/inventory.yaml
WorkingDirectory=/opt/singbox-failover
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/sing-box /opt/singbox-failover /home/<USER>/.hermes
